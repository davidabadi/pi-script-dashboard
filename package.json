{
  "name": "pi-script-dashboard",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "migrate": "node bin/migrate.js",
    "backup": "node bin/backup.js",
    "test": "node --test",
    "check": "node --check server.js && node --check worker.js && node --check public/app.js && node --check lib/live-events.js && node --check lib/change-channel.js && node --test",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "build:css": "tailwindcss -i ./tailwind.css -o ./public/tailwind.css --minify"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "ejs": "3.1.10",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "monaco-editor": "0.40.0",
    "session-file-store": "1.5.0",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.11",
    "tailwindcss": "4.1.11"
  }
}
