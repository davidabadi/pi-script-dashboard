<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Log - <%= name %></title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="stylesheet" href="/tailwind.css?v=<%= cacheBust %>" />
  <script nonce="<%= cspNonce %>" src="/vendor/monaco/vs/loader.js"></script>
</head>
<body class="app-shell">
  <main class="page-container">
    <header class="app-header mb-6">
      <div class="app-brand min-w-0">
        <img src="/favicon.svg" alt="" class="app-logo" />
        <div class="min-w-0">
          <h1 class="page-title break-words"><%= name %></h1>
          <p class="page-subtitle">Log &middot; Last 100 lines &middot; Read only</p>
        </div>
      </div>
      <a href="/" class="btn btn-ghost flex-none">Back to scripts</a>
    </header>
    <section class="panel p-3 sm:p-4" aria-label="Log output">
      <div class="editor-frame h-[70vh]" id="editor"></div>
    </section>
  </main>

  <script nonce="<%= cspNonce %>">
    require.config({ paths: { vs: '/vendor/monaco/vs' } });
    require(['vs/editor/editor.main'], function () {
      const mql = window.matchMedia('(prefers-color-scheme: dark)');
      const currentTheme = () => (mql.matches ? 'vs-dark' : 'vs');
      monaco.editor.create(document.getElementById('editor'), {
        value: <%- safeJson(content.join('\n')) %>,
        language: 'shell',
        readOnly: true,
        automaticLayout: true,
        theme: currentTheme(),
        minimap: { enabled: false },
        fontFamily: "'Fira Code', 'Cascadia Code', 'Source Code Pro', 'Menlo', monospace"
      });

      const applyTheme = () => monaco.editor.setTheme(currentTheme());
      applyTheme();
      if (mql.addEventListener) {
        mql.addEventListener('change', applyTheme);
      } else if (mql.addListener) {
        mql.addListener(applyTheme);
      }
    });
  </script>
</body>
</html>
