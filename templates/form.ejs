<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title><%= isNew ? 'New script' : 'Edit script' %> - Pi Script Dashboard</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />
  <link rel="stylesheet" href="/tailwind.css?v=<%= cacheBust %>" />
  <script nonce="<%= cspNonce %>" src="/vendor/monaco/vs/loader.js"></script>
</head>
<body class="app-shell">
  <main class="page-container">
    <header class="app-header mb-6">
      <div class="app-brand min-w-0">
        <img src="/favicon.svg" alt="" class="app-logo" />
        <div class="min-w-0">
          <h1 class="page-title break-words"><%= isNew ? 'New script' : data.name %></h1>
          <% if (!isNew) { %><p class="page-subtitle">Edit script</p><% } %>
        </div>
      </div>
      <a href="/" class="btn btn-ghost flex-none">Back to scripts</a>
    </header>

    <% if (messages && messages.length) { %>
      <div class="mb-5 space-y-3" role="status">
        <% messages.forEach(msg => { %>
          <div class="alert <%= msg.category === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
        <% }) %>
      </div>
    <% } %>

    <form method="POST" aria-label="Script details" class="panel space-y-6 p-5 sm:p-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <label for="name" class="field-label">Name</label>
          <input id="name" type="text" name="name" value="<%= data.name %>" required class="input" />
        </div>
        <div class="space-y-2">
          <label for="timer" class="field-label">Cron schedule</label>
          <input id="timer" type="text" name="timer" value="<%= data.timer %>" required class="input font-mono" />
        </div>
        <div class="space-y-2 sm:col-span-2">
          <label for="script" class="field-label">Script path</label>
          <input id="script" type="text" name="script" value="<%= data.script %>" required class="input font-mono" />
        </div>
        <div class="space-y-2">
          <label for="log" class="field-label">Log path</label>
          <input id="log" type="text" name="log" value="<%= data.log %>" required class="input font-mono" />
        </div>
        <div class="space-y-2">
          <label for="lock" class="field-label">Lock path</label>
          <input id="lock" type="text" name="lock" value="<%= data.lock %>" required class="input font-mono" />
        </div>
      </div>

      <input type="hidden" name="content" id="hidden-content" />
      <input type="hidden" name="config_content" id="hidden-config-content" />
      <input type="hidden" name="config_enabled" id="config-enabled" value="<%= data.config_path ? 'true' : 'false' %>" />
      <section aria-labelledby="script-heading" class="space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="script-heading" class="text-sm font-semibold">Script</h2>
          <div class="flex items-center gap-2">
            <button type="button" id="clear-script" class="btn btn-ghost">Clear script</button>
            <% if (!isNew) { %>
              <button type="button" id="copy-script" class="btn btn-ghost">Copy script</button>
            <% } %>
          </div>
        </div>
        <div id="editor" class="editor-frame h-[60vh]"></div>
      </section>

      <section aria-labelledby="config-heading" class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="config-heading" class="text-sm font-semibold">Config file</h2>
          <button type="button" id="config-toggle" class="btn btn-ghost" aria-labelledby="config-heading config-toggle-label" aria-controls="config-section" aria-pressed="<%= data.config_path ? 'true' : 'false' %>">
            <span id="config-toggle-label"><%= data.config_path ? 'Enabled' : 'Disabled' %></span>
          </button>
        </div>
        <div id="config-section" class="<%= data.config_path ? '' : 'hidden' %> space-y-4">
          <div class="space-y-2">
            <label for="config_path" class="field-label">Config path</label>
            <input id="config_path" type="text" name="config_path" value="<%= data.config_path %>" class="input font-mono" />
          </div>
          <div id="config-editor" class="editor-frame h-[40vh]"></div>
          <div class="flex flex-wrap justify-end gap-2">
            <button type="button" id="clear-config" class="btn btn-ghost">Clear config</button>
            <% if (!isNew) { %>
              <button type="button" id="copy-config" class="btn btn-ghost">Copy config</button>
            <% } %>
          </div>
        </div>
      </section>

      <div class="flex flex-wrap justify-end gap-2">
        <a href="/" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary"><%= isNew ? 'Add script' : 'Save changes' %></button>
      </div>
    </form>
  </main>

  <script nonce="<%= cspNonce %>">
    require.config({ paths: { vs: '/vendor/monaco/vs' } });
    require(['vs/editor/editor.main'], function () {
      const mql = window.matchMedia('(prefers-color-scheme: dark)');
      const currentTheme = () => (mql.matches ? 'vs-dark' : 'vs');
      const editor = monaco.editor.create(document.getElementById('editor'), {
        value: <%- safeJson(data.content) %>,
        language: 'shell',
        automaticLayout: true,
        theme: currentTheme(),
        minimap: { enabled: false },
        fontFamily: "'Fira Code', 'Cascadia Code', 'Source Code Pro', 'Menlo', monospace"
      });
      const configEditor = monaco.editor.create(document.getElementById('config-editor'), {
        value: <%- safeJson(data.config_content || '') %>,
        language: 'yaml',
        automaticLayout: true,
        theme: currentTheme(),
        minimap: { enabled: false },
        fontFamily: "'Fira Code', 'Cascadia Code', 'Source Code Pro', 'Menlo', monospace"
      });

      const applyTheme = () => monaco.editor.setTheme(currentTheme());
      applyTheme();
      if (mql.addEventListener) {
        mql.addEventListener('change', applyTheme);
      } else if (mql.addListener) {
        mql.addListener(applyTheme);
      }

      const form = document.querySelector('form');
      const clearButton = document.getElementById('clear-script');
      const copyButton = document.getElementById('copy-script');
      const clearConfigButton = document.getElementById('clear-config');
      const copyConfigButton = document.getElementById('copy-config');
      const configToggle = document.getElementById('config-toggle');
      const configToggleLabel = document.getElementById('config-toggle-label');
      const configSection = document.getElementById('config-section');
      const configPathField = document.getElementById('config_path');
      const configEnabledField = document.getElementById('config-enabled');
      const fields = [
        document.getElementById('name'),
        document.getElementById('script'),
        document.getElementById('log'),
        document.getElementById('lock'),
        document.getElementById('timer'),
        configPathField
      ];
      const getFormSnapshot = () => ({
        name: fields[0].value,
        script: fields[1].value,
        log: fields[2].value,
        lock: fields[3].value,
        timer: fields[4].value,
        content: editor.getValue(),
        config_path: fields[5].value,
        config_content: configEditor.getValue(),
        config_enabled: configEnabledField.value
      });
      const initialSnapshot = getFormSnapshot();
      let isDirty = false;
      const updateDirtyState = () => {
        const currentSnapshot = getFormSnapshot();
        isDirty = Object.keys(initialSnapshot).some((key) => currentSnapshot[key] !== initialSnapshot[key]);
      };

      fields.forEach((field) => field.addEventListener('input', updateDirtyState));
      editor.onDidChangeModelContent(updateDirtyState);
      configEditor.onDidChangeModelContent(updateDirtyState);

      window.addEventListener('beforeunload', (event) => {
        if (!isDirty) {
          return;
        }
        event.preventDefault();
        event.returnValue = 'You have unsaved changes.';
      });

      if (clearButton) {
        const resetClearLabel = () => {
          clearButton.textContent = 'Clear script';
          clearButton.disabled = false;
        };
        clearButton.addEventListener('click', () => {
          editor.setValue('');
          editor.focus();
          clearButton.textContent = 'Cleared!';
          clearButton.disabled = true;
          setTimeout(resetClearLabel, 2000);
        });
      }

      if (copyButton) {
        const resetCopyLabel = () => {
          copyButton.textContent = 'Copy script';
          copyButton.disabled = false;
        };
        copyButton.addEventListener('click', () => {
          const content = editor.getValue();
          copyButton.textContent = 'Copying...';
          copyButton.disabled = true;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(content).then(() => {
              copyButton.textContent = 'Copied!';
              setTimeout(resetCopyLabel, 2000);
            }).catch(() => {
              resetCopyLabel();
              window.alert('Unable to copy script to clipboard.');
            });
            return;
          }

          const textarea = document.createElement('textarea');
          textarea.value = content;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand('copy');
          document.body.removeChild(textarea);
          if (copied) {
            copyButton.textContent = 'Copied!';
            setTimeout(resetCopyLabel, 2000);
          } else {
            resetCopyLabel();
            window.alert('Unable to copy script to clipboard.');
          }
        });
      }

      if (clearConfigButton) {
        const resetClearConfigLabel = () => {
          clearConfigButton.textContent = 'Clear config';
          clearConfigButton.disabled = false;
        };
        clearConfigButton.addEventListener('click', () => {
          configEditor.setValue('');
          configEditor.focus();
          clearConfigButton.textContent = 'Cleared!';
          clearConfigButton.disabled = true;
          setTimeout(resetClearConfigLabel, 2000);
        });
      }

      if (copyConfigButton) {
        const resetCopyConfigLabel = () => {
          copyConfigButton.textContent = 'Copy config';
          copyConfigButton.disabled = false;
        };
        copyConfigButton.addEventListener('click', () => {
          const content = configEditor.getValue();
          copyConfigButton.textContent = 'Copying...';
          copyConfigButton.disabled = true;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(content).then(() => {
              copyConfigButton.textContent = 'Copied!';
              setTimeout(resetCopyConfigLabel, 2000);
            }).catch(() => {
              resetCopyConfigLabel();
              window.alert('Unable to copy config to clipboard.');
            });
            return;
          }

          const textarea = document.createElement('textarea');
          textarea.value = content;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand('copy');
          document.body.removeChild(textarea);
          if (copied) {
            copyConfigButton.textContent = 'Copied!';
            setTimeout(resetCopyConfigLabel, 2000);
          } else {
            resetCopyConfigLabel();
            window.alert('Unable to copy config to clipboard.');
          }
        });
      }

      if (configToggle) {
        const syncToggleState = (enabled) => {
          const isEnabled = Boolean(enabled);
          configToggle.setAttribute('aria-pressed', isEnabled ? 'true' : 'false');
          configToggleLabel.textContent = isEnabled ? 'Enabled' : 'Disabled';
          configEnabledField.value = isEnabled ? 'true' : 'false';
          if (isEnabled) {
            configSection.classList.remove('hidden');
            configEditor.layout();
          } else {
            configSection.classList.add('hidden');
          }
          updateDirtyState();
        };

        configToggle.addEventListener('click', () => {
          const nextState = configToggle.getAttribute('aria-pressed') !== 'true';
          syncToggleState(nextState);
        });

        syncToggleState(configToggle.getAttribute('aria-pressed') === 'true');
      }

      form.addEventListener('submit', () => {
        document.getElementById('hidden-content').value = editor.getValue();
        document.getElementById('hidden-config-content').value = configEditor.getValue();
        isDirty = false;
      });
    });
  </script>
</body>
</html>
