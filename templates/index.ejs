<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Pi Script Dashboard</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png?v=<%= cacheBust %>" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= cacheBust %>" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%= cacheBust %>" />
  <link rel="manifest" href="/site.webmanifest?v=<%= cacheBust %>" crossorigin="use-credentials" />
  <link rel="stylesheet" href="/tailwind.css?v=<%= cacheBust %>" />
  <script nonce="<%= cspNonce %>" src="/vendor/monaco/vs/loader.js"></script>
</head>
<body class="app-shell">
  <% const statusLabels = { queued: 'Queued', running: 'Running', succeeded: 'Succeeded', partial: 'Partial', failed: 'Failed', interrupted: 'Interrupted', skipped: 'Skipped' }; %>
  <% const runningCount = scriptOrder.filter(name => status[name] === 'running').length; %>
  <% const pausedCount = scriptOrder.filter(name => paused[name]).length; %>
  <div class="page-container">
    <header class="app-header">
      <a href="/" class="app-brand" aria-label="Pi Script Dashboard home">
        <img src="/favicon.svg?v=<%= cacheBust %>" alt="" class="app-logo" />
        <span>Pi Script Dashboard</span>
      </a>
      <div class="header-actions">
        <a href="/new" class="btn btn-primary">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          New script
        </a>
        <details class="utility-menu">
          <summary class="btn btn-ghost icon-button" aria-label="Dashboard options" title="Dashboard options">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></svg>
          </summary>
          <div class="menu-panel">
            <button id="update-button" type="button" class="menu-item">Update dashboard</button>
            <form method="POST" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="menu-item">Sign out</button>
            </form>
          </div>
        </details>
      </div>
    </header>

    <% if (messages && messages.length) { %>
      <div class="mb-5 space-y-2" role="status">
        <% messages.forEach(msg => { %>
          <div class="alert <%= msg.category === 'success' ? 'alert-success' : 'alert-error' %>"><%= msg.text %></div>
        <% }) %>
      </div>
    <% } %>

    <main>
      <section class="scripts-section" aria-labelledby="scripts-heading">
        <div class="section-toolbar">
          <div>
            <h1 id="scripts-heading" class="page-title">Scripts</h1>
            <div class="script-counts" aria-label="Script summary">
              <span><strong><%= scriptOrder.length %></strong> <%= scriptOrder.length === 1 ? 'script' : 'scripts' %></span>
              <span><i class="status-dot count-running" aria-hidden="true"></i><strong id="running-count"><%= runningCount %></strong> running</span>
              <span><i class="status-dot count-paused" aria-hidden="true"></i><strong><%= pausedCount %></strong> paused</span>
            </div>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <button id="reorder-button" type="button" class="btn btn-ghost" <%= scriptOrder.length < 2 ? 'hidden' : '' %>>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4v16m-3-3 3 3 3-3M16 20V4m-3 3 3-3 3 3" /></svg>
              Reorder
            </button>
            <button id="save-order-button" type="button" hidden class="btn btn-primary">Save order</button>
            <button id="cancel-order-button" type="button" hidden class="btn">Cancel</button>
          </div>
        </div>

        <p id="live-connection" class="reorder-note" role="status"><%= worker.online ? (worker.draining ? 'Finishing active jobs before an update.' : 'Live updates connected.') : 'Execution service is offline. Queued jobs will wait.' %></p>
        <div id="schedule-warning" class="alert alert-error mb-4" <%= schedulerPending ? '' : 'hidden' %>>
          <p>Schedules need synchronization. Execution is paused.</p>
          <form id="schedule-sync-form" method="POST" action="/sync-cron" class="mt-2" <%= contentRecovery ? 'hidden' : '' %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn">Retry schedule sync</button>
          </form>
          <form id="edit-recovery-form" method="POST" action="/recover-edit" class="mt-2" <%= contentRecovery ? '' : 'hidden' %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <p>A file edit was interrupted. Restore its original files before synchronizing.</p>
            <button type="submit" class="btn">Recover interrupted edit</button>
          </form>
        </div>
        <div class="panel">
          <% if (scriptOrder.length) { %>
            <div class="script-columns" aria-hidden="true">
              <span>Script</span><span>Last run</span><span>Schedule</span><span class="text-right">Actions</span>
            </div>
          <% } %>
          <div id="scripts-list">
            <% scriptOrder.forEach((name, index) => { %>
              <% const state = status[name]; %>
              <% const displayState = state ? (statusLabels[state] ? state : 'failed') : ''; %>
              <article class="script-row" data-name="<%= name %>" data-job-id="<%= jobs[index].id %>" aria-label="<%= name %>">
                <div class="script-identity">
                  <div class="drag-controls">
                    <span class="drag-handle" data-drag-handle aria-hidden="true">
                      <svg class="icon" viewBox="0 0 24 24"><path d="M9 5h.01M15 5h.01M9 12h.01M15 12h.01M9 19h.01M15 19h.01" stroke-width="3" /></svg>
                    </span>
                    <div>
                      <button type="button" class="move-button" data-move="up" aria-label="Move <%= name %> up"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 14 5-5 5 5" /></svg></button>
                      <button type="button" class="move-button" data-move="down" aria-label="Move <%= name %> down"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></button>
                    </div>
                  </div>
                  <div class="min-w-0">
                    <h2 class="script-name"><%= name %></h2>
                    <div class="script-meta">
                      <span class="status-badge" data-state="<%= displayState %>">
                        <span class="status-dot" aria-hidden="true"></span>
                        <span data-status-label><%= displayState ? statusLabels[displayState] : 'Not run' %></span>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="script-last-run"><p data-last-run><%= state === 'running' ? 'In progress' : (last_run[name] || 'Never') %></p><p data-progress class="text-xs break-words"><%= jobs[index].message %></p></div>
                <form method="POST" action="/toggle_cron/<%= encodeURIComponent(name) %>" class="schedule-control">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <span class="schedule-state <%= paused[name] ? 'is-paused' : '' %>"><%= paused[name] ? 'Paused' : 'Active' %></span>
                  <button type="submit" class="schedule-button" aria-label="<%= paused[name] ? 'Resume' : 'Pause' %> cron for <%= name %>"><%= paused[name] ? 'Resume' : 'Pause' %></button>
                </form>
                <div class="script-actions">
                  <form method="POST" action="/run/<%= encodeURIComponent(name) %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" data-run-button class="btn btn-run" aria-label="Run <%= name %>" <%= ['queued', 'running'].includes(state) ? 'disabled' : '' %>>
                      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7V5Z" /></svg>Run
                    </button>
                  </form>
                  <a href="/edit/<%= encodeURIComponent(name) %>" class="btn btn-ghost" aria-label="Edit <%= name %>">Edit</a>
                  <a href="/log/<%= encodeURIComponent(name) %>" class="btn btn-ghost" aria-label="View log for <%= name %>">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 6 5 5-5 5M13 18h6" /></svg>History &amp; logs
                  </a>
                </div>
              </article>
            <% }) %>
          </div>
          <% if (!scriptOrder.length) { %>
            <div class="empty-state">
              <p>No scripts yet.</p>
              <a href="/new" class="btn btn-primary">New script</a>
            </div>
          <% } %>
        </div>
        <p id="reorder-note" class="reorder-note" hidden>Drag to reorder, or use the arrow buttons.</p>
        <p id="order-status" class="sr-only" role="status"></p>
      </section>

      <details class="panel cron-panel">
        <summary>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l3 2" /></svg>
          Crontab
          <svg class="icon chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </summary>
        <div id="cron-editor" class="editor-frame" aria-label="Current crontab, read only"></div>
      </details>
    </main>
  </div>

  <script nonce="<%= cspNonce %>">
    const csrfToken = <%- safeJson(csrfToken) %>;
    const statusLabels = <%- safeJson(statusLabels) %>;
    const connection = document.getElementById('live-connection');
    let sessionExpired = false;
    async function refreshJobs() {
      try {
        const response = await fetch('/api/jobs', { cache: 'no-store' });
        if (response.status === 401) {
          sessionExpired = true;
          connection.replaceChildren(document.createTextNode('Session expired. '));
          const link = document.createElement('a'); link.href = '/login'; link.textContent = 'Sign in again'; connection.appendChild(link);
          return;
        }
        if (!response.ok) throw new Error('Refresh failed');
        const data = await response.json();
        document.getElementById('schedule-warning').hidden = !data.schedulerPending;
        document.getElementById('edit-recovery-form').hidden = !data.contentRecovery;
        document.getElementById('schedule-sync-form').hidden = data.contentRecovery;
        document.getElementById('running-count').textContent = data.jobs.filter(job => job.status === 'running').length;
        let changed = data.jobs.length !== document.querySelectorAll('[data-job-id]').length;
        for (const job of data.jobs) {
          const row = document.querySelector(`[data-job-id="${CSS.escape(job.id)}"]`);
          if (!row || row.dataset.name !== job.name) { changed = true; continue; }
          row.querySelector('.status-badge').dataset.state = job.status || '';
          row.querySelector('[data-status-label]').textContent = statusLabels[job.status] || 'Not run';
          row.querySelector('[data-last-run]').textContent = job.status === 'running' ? 'In progress' : (job.last_run ? new Date(job.last_run).toLocaleString() : 'Never');
          row.querySelector('[data-progress]').textContent = job.message || '';
          row.querySelector('[data-run-button]').disabled = data.schedulerPending || ['queued', 'running'].includes(job.status);
        }
        connection.textContent = changed ? 'The script list changed. Reload to see the latest list.' : (!data.worker.online ? 'Execution service is offline. Queued jobs will wait.' : data.worker.draining ? 'Finishing active jobs before an update.' : 'Live updates connected.');
      } catch {
        connection.textContent = 'Connection lost. Reconnecting…';
      } finally { if (!sessionExpired) setTimeout(refreshJobs, 2000); }
    }
    setTimeout(refreshJobs, 2000);
    async function runUpdate() {
      const button = document.getElementById('update-button');
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.textContent = 'Updating...';

      try {
        const response = await fetch('/update', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken } });
        if (!response.ok) throw new Error('Update request failed');
      } catch (error) {
        console.error('Update trigger failed', error);
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = 'Try again';
        return;
      }

      const finish = () => {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = 'Reload to apply';
        button.onclick = () => window.location.reload();
      };

      const checkStatus = async () => {
        try {
          const res = await fetch('/update-status');
          if (res.status === 401) {
            button.disabled = false;
            button.removeAttribute('aria-busy');
            button.textContent = 'Sign in to check update';
            button.onclick = () => { window.location.href = '/login'; };
            return true;
          }
          if (!res.ok) throw new Error('Status request failed');
          const data = await res.json();
          if (data.status === 'failed') {
            button.disabled = false;
            button.removeAttribute('aria-busy');
            button.textContent = 'Update failed';
            connection.textContent = data.message || 'Update failed. Check deployment service logs.';
            return true;
          }
          if (['waiting', 'draining'].includes(data.status)) button.textContent = 'Waiting for jobs…';
          if (data.status === 'succeeded') {
            finish();
            return true;
          }
        } catch (error) {
          connection.textContent = 'Reconnecting while the dashboard updates…';
        }
        return false;
      };

      if (await checkStatus()) {
        return;
      }

      const interval = setInterval(async () => {
        if (await checkStatus()) {
          clearInterval(interval);
        }
      }, 2000);
    }

    require.config({
      paths: {
        vs: '/vendor/monaco/vs',
        sortablejs: '/vendor/sortable/Sortable.min'
      }
    });

    require(['vs/editor/editor.main', 'sortablejs'], function (_, Sortable) {
      const mql = window.matchMedia('(prefers-color-scheme: dark)');
      const currentTheme = () => (mql.matches ? 'vs-dark' : 'vs');
      monaco.editor.create(document.getElementById('cron-editor'), {
        value: <%- safeJson(cron_output) %>,
        language: 'shell',
        readOnly: true,
        automaticLayout: true,
        theme: currentTheme(),
        minimap: { enabled: false }
      });

      const applyTheme = () => monaco.editor.setTheme(currentTheme());
      applyTheme();
      if (mql.addEventListener) {
        mql.addEventListener('change', applyTheme);
      } else if (mql.addListener) {
        mql.addListener(applyTheme);
      }

      const list = document.getElementById('scripts-list');
      const reorderButton = document.getElementById('reorder-button');
      const saveOrderButton = document.getElementById('save-order-button');
      const cancelOrderButton = document.getElementById('cancel-order-button');
      if (list) {
        const getOrder = () => Array.from(list.children).map((node) => node.dataset.name);
        const applyOrder = (order) => {
          order.forEach((name) => {
            const selector = `[data-name="${CSS.escape(name)}"]`;
            const node = list.querySelector(selector);
            if (node) {
              list.appendChild(node);
            }
          });
        };
        let originalOrder = getOrder();
        const setReorderMode = (enabled) => {
          if (!reorderButton || !saveOrderButton || !cancelOrderButton) return;
          reorderButton.hidden = enabled || list.children.length < 2;
          saveOrderButton.hidden = !enabled;
          cancelOrderButton.hidden = !enabled;
          list.classList.toggle('is-reordering', enabled);
          const note = document.getElementById('reorder-note');
          note.hidden = !enabled;
          note.textContent = 'Drag to reorder, or use the arrow buttons.';
          note.removeAttribute('role');
        };
        const sortable = Sortable.create(list, {
          animation: 200,
          disabled: true,
          handle: '[data-drag-handle]',
          onStart: (evt) => evt.item.classList.add('opacity-60'),
          onEnd: (evt) => {
            evt.item.classList.remove('opacity-60');
          }
        });

        list.addEventListener('click', (event) => {
          const button = event.target.closest('[data-move]');
          if (!button || !list.classList.contains('is-reordering')) return;
          const row = button.closest('[data-name]');
          const adjacent = button.dataset.move === 'up' ? row.previousElementSibling : row.nextElementSibling;
          if (!adjacent) return;
          if (button.dataset.move === 'up') list.insertBefore(row, adjacent);
          else list.insertBefore(adjacent, row);
          button.focus();
          document.getElementById('order-status').textContent = `${row.dataset.name} moved ${button.dataset.move}.`;
        });

        if (reorderButton && saveOrderButton && cancelOrderButton) {
          setReorderMode(false);
          reorderButton.addEventListener('click', () => {
            originalOrder = getOrder();
            sortable.option('disabled', false);
            setReorderMode(true);
          });

          cancelOrderButton.addEventListener('click', () => {
            applyOrder(originalOrder);
            sortable.option('disabled', true);
            setReorderMode(false);
          });

          saveOrderButton.addEventListener('click', async () => {
            const order = getOrder();
            sortable.option('disabled', true);
            setReorderMode(false);
            try {
              const response = await fetch('/reorder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ order })
              });
              if (!response.ok) throw new Error('Order request failed');
              document.getElementById('order-status').textContent = 'Script order saved.';
            } catch (error) {
              console.error('Failed to persist script order', error);
              sortable.option('disabled', false);
              setReorderMode(true);
              const note = document.getElementById('reorder-note');
              note.textContent = 'Could not save the order. Try again.';
              note.setAttribute('role', 'alert');
            }
          });
        }
      }
    });
    document.getElementById('update-button')?.addEventListener('click', runUpdate);
    const utilityMenu = document.querySelector('.utility-menu');
    document.addEventListener('click', (event) => {
      if (!utilityMenu.contains(event.target)) utilityMenu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && utilityMenu.open) {
        utilityMenu.open = false;
        utilityMenu.querySelector('summary').focus();
      }
    });
  </script>
</body>
</html>
