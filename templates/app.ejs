<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Pi Script Dashboard</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png?v=<%= cacheBust %>" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= cacheBust %>" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%= cacheBust %>" />
  <link rel="manifest" href="/site.webmanifest?v=<%= cacheBust %>" crossorigin="use-credentials" />
  <link rel="stylesheet" href="/tailwind.css?v=<%= cacheBust %>" />
  <link rel="stylesheet" href="/app.css?v=<%= cacheBust %>" />
  <script nonce="<%= cspNonce %>" src="/vendor/monaco/vs/loader.js"></script>
  <script nonce="<%= cspNonce %>">window.__DASHBOARD__ = <%- safeJson(bootstrap) %>;</script>
  <script nonce="<%= cspNonce %>" src="/app.js?v=<%= cacheBust %>" defer></script>
</head>
<body class="app-shell">
  <a class="skip-link" href="#app-main">Skip to content</a>
  <div class="page-container">
    <header class="app-header">
      <a href="/" class="app-brand" aria-label="Pi Script Dashboard home" data-nav>
        <img src="/favicon.svg?v=<%= cacheBust %>" alt="" class="app-logo" />
        <span>Pi Script Dashboard</span>
      </a>
      <div class="header-actions">
        <a href="/new" class="btn btn-primary" data-nav>+ New script</a>
        <details class="utility-menu">
          <summary class="btn btn-ghost icon-button" aria-label="Dashboard options" title="Dashboard options">•••</summary>
          <div class="menu-panel">
            <button id="update-button" type="button" class="menu-item">Update dashboard</button>
            <button id="logout-button" type="button" class="menu-item">Sign out</button>
          </div>
        </details>
      </div>
    </header>
    <div id="connection-status" class="connection-status" data-state="connecting">
      <span class="connection-badge" role="status" aria-live="polite"><span class="status-dot" aria-hidden="true"></span><span id="connection-label">Connecting</span></span>
      <button id="reconnect-button" type="button" class="btn btn-ghost connection-reconnect" hidden>Reconnect</button>
    </div>
    <div id="service-notice" class="service-notice" role="status" hidden></div>
    <div id="app-messages" class="app-messages" aria-live="polite"></div>
    <main id="app-main" tabindex="-1" aria-busy="true"><p class="page-subtitle">Loading dashboard…</p></main>
    <noscript><p class="alert alert-error">JavaScript is required for this dashboard. Enable it, then reload this page.</p></noscript>
  </div>
</body>
</html>
