[Unit]
Description=Apply a Pi Script Dashboard update
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/pi-script-dashboard-update
# The helper reports a durable drain timeout instead of being killed mid-update.
TimeoutStartSec=3h
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
