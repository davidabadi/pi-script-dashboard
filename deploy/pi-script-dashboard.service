[Unit]
Description=Pi Script Dashboard
After=network-online.target pi-script-dashboard-auth.service
Wants=network-online.target
Requires=pi-script-dashboard-auth.service

[Service]
Type=simple
User=pi-dashboard
Group=pi-dashboard
# Give Debian's per-user crontab helper spool access without a setgid transition.
SupplementaryGroups=crontab
NoNewPrivileges=true
WorkingDirectory=/opt/pi-script-dashboard
Environment=NODE_ENV=production
EnvironmentFile=/etc/pi-script-dashboard/environment
ExecStart=/usr/local/bin/node /opt/pi-script-dashboard/server.js
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=pi-script-dashboard
StateDirectoryMode=0700
LogsDirectory=pi-script-dashboard
LogsDirectoryMode=0700
# /run/pi-script-dashboard is created by tmpfiles and shared with the worker.
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# The crontab helper retains its per-user checks; the sticky spool protects other users.
ReadWritePaths=/var/lib/pi-script-dashboard /var/log/pi-script-dashboard /run/pi-script-dashboard /var/spool/cron/crontabs

[Install]
WantedBy=multi-user.target
